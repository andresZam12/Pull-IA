# ─────────────────────────────────────────────
# PULL-IA — Environment Variables
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# ── Database (Supabase) ──────────────────────
# Get these from: https://supabase.com → Settings → Database → Connection String
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── Google Gemini AI ─────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ── NextAuth.js (Auth) ───────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-nextauth-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth Provider
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth Provider
# Get from: https://github.com/settings/developers
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ── Resend (Email) ───────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY="re_your-resend-api-key"
RESEND_FROM_EMAIL="newsletter@pull-ia.com"
RESEND_FROM_NAME="PULL-IA"

# ── Upstash Redis (Rate Limiting) ────────────
# Get from: https://upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ── Cron Security ────────────────────────────
# Random secret to protect cron endpoints from unauthorized calls
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret"

# ── App Config ───────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PULL-IA"

# ── Optional: Dev.to API ─────────────────────
# Get from: https://dev.to/settings/extensions
DEVTO_API_KEY=""

# ── Optional: ProductHunt API ────────────────
# Get from: https://api.producthunt.com/v2/oauth/applications
PRODUCTHUNT_CLIENT_ID=""
PRODUCTHUNT_CLIENT_SECRET=""
